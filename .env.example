# Student Bot - Root Environment Variables
# Copy to .env and fill in your values

# ============================================
# REQUIRED - Get from @BotFather
# ============================================
BOT_TOKEN=123456789:ABCdefGhIjKlMnOpQrStUvWxYz
BOT_USERNAME=your_student_bot

# ============================================
# SECURITY - Generate strong random strings
# ============================================
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars-long-change-in-production
DB_PASSWORD=your-secure-db-password

# ============================================
# URLs - Update for your deployment
# ============================================
MINI_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ============================================
# DATABASE (for Docker/production)
# ============================================
# For local dev, backend uses SQLite file (no config needed)
# For production with Docker:
# DATABASE_URL=postgresql://student_bot:your-password@db:5432/student_bot?schema=public

# ============================================
# FRONTEND (Vercel Environment Variables)
# ============================================
# VITE_API_URL=https://your-backend.railway.app/api/v1
# VITE_WS_URL=wss://your-backend.railway.app/ws
# VITE_BOT_USERNAME=your_student_bot

# ============================================
# OPTIONAL
# ============================================
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads